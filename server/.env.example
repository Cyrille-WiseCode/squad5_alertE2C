PORT=4000
JWT_SECRET=replace-this-with-a-long-random-secret
NODE_ENV=development
CLIENT_ORIGINS=http://localhost:5173

# Optional: creates a dedicated demo agent on first startup when all three values are set.
# Keep the real values in your host's secret/environment-variable settings, never in Git.
E2C_AGENT_NAME=
E2C_AGENT_PHONE=
E2C_AGENT_PASSWORD=

# Optional persistent directories. Leave empty for the local defaults.
E2C_DATA_DIR=
E2C_UPLOADS_DIR=
